<?xml version="1.0" encoding="UTF-8"?>
<!-- Input: 加载项清单配置 -->
<!-- Output: WPS 加载项注册元数据 -->
<!-- Pos: macOS 加载项清单入口。一旦我被修改，请更新我的头部注释，以及所属文件夹的md。 -->
<manifest xmlns="http://schemas.wps.cn/oaassist/2019/manifest"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <id>wps-assistant</id>
    <version>1.0.0</version>
    <name>WPS助手</name>
    <description>WPS Office 的桥接加载项（轮询模式）</description>
    <author>WPS-Skills Team</author>

    <!-- 支持的WPS应用类型 -->
    <hosts>
        <host name="wps"/>
        <host name="et"/>
        <host name="wpp"/>
    </hosts>

    <!-- 权限声明 -->
    <permissions>
        <permission name="document.read"/>
        <permission name="document.write"/>
    </permissions>

    <!-- 功能区配置 -->
    <ribbon src="ribbon.xml"/>

    <!-- 脚本入口 -->
    <scripts>
        <script src="main.js"/>
    </scripts>
</manifest>
